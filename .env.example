# Copier ce fichier en .env et renseigner les valeurs : cp .env.example .env
# Le fichier .env n'est jamais commité. En production, ces variables sont
# injectées par la plateforme (Azure Container Apps + Key Vault).

# --- Secrets (obligatoires) ---------------------------------------------------
OPENAI_API_KEY=

# --- Traçage LangSmith (optionnel) --------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-vehicules

# --- Ingestion : changer une de ces valeurs impose de relancer l'ingestion ---
# DOCS_DIR=./data/docs
# INDEX_DIR=./data/index
# COLLECTION_NAME=vehicules
# CHUNK_SIZE=600
# CHUNK_OVERLAP=60
# EMBEDDING_MODEL=text-embedding-3-large

# --- Requête : modifiables sans réindexer (valeurs par défaut indiquées) --------
# LLM_MODEL=gpt-4o
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2
# RETRIEVER_K=50
# BM25_WEIGHT=0.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANK_TOP_K=5
# RERANK_THRESHOLD=0.2
# HTTP_TIMEOUT_S=10

# --- Interface Streamlit --------------------------------------------------------
# API_URL=http://localhost:8000
